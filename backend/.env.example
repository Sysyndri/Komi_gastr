# ============================================================================
# Backend — шаблон для локального запуска БЕЗ Docker (npm run dev).
# Скопируйте в backend/.env (файл в .gitignore) и заполните значения.
# В docker compose переменные приходят из корневого .env — этот файл не нужен.
# ============================================================================
NODE_ENV=development
PORT=4000

# PostgreSQL: поднимите базу командой `docker compose up -d postgres` в корне.
# Пароль должен совпадать с POSTGRES_PASSWORD из корневого .env.
DATABASE_URL=postgresql://komi:ПАРОЛЬ_ИЗ_POSTGRES_PASSWORD@localhost:5432/gastro_komi?schema=public

# Секреты подписи токенов: значения должны различаться и быть >= 32 символов.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Разрешённые origin для CORS (список через запятую)
CORS_ORIGIN=http://localhost:3000

# Лимиты запросов: окно (мс) и число запросов на IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# --- Только для NODE_ENV=production ----------------------------------------
# В development проверки публичных адресов и длины секретов отключены.
API_PUBLIC_URL=
# ALLOW_LOCALHOST=true разрешает localhost в публичных адресах (локальный стенд)
ALLOW_LOCALHOST=
# X-Forwarded-* доверять только за nginx/Traefik
TRUST_PROXY=false
SWAGGER_ENABLED=true

# Учётные данные, которые создаёт `npm run seed`.
# Повторный запуск синхронизирует пароли с этими значениями.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=

