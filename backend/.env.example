# Backend — шаблон окружения. Скопируйте в backend/.env и заполните своими
# значениями. Реальные секреты и пароли в этот файл не вносите!
NODE_ENV=development
PORT=4000

# PostgreSQL (в docker-compose значения берутся из POSTGRES_USER/PASSWORD/DB)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public

# Секреты подписи токенов. Сгенерируйте уникальные значения:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=__CHANGE_ME_ACCESS_SECRET__
JWT_REFRESH_SECRET=__CHANGE_ME_REFRESH_SECRET__
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Разрешённые origin для CORS (список через запятую)
CORS_ORIGIN=http://localhost:3000

# Учётная запись администратора, создаётся сидом (npm run prisma:seed).
# Значения задаются только локально; демо-пароли описаны в закрытом
# DEVELOPER_NOTES.md и в репозиторий не попадают.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Прод / reverse-proxy (docker-compose.prod.yml поднимает всё само) ------
# X-Forwarded-* доверять только когда сервер стоит за nginx/Traefik:
# true — любому, число (например 1) — только последнему N прокси в цепочке.
TRUST_PROXY=false
# Лимиты запросов: глобальный на IP за окно, отдельный на логин/регистрацию.
# Окна — в миллисекундах. Для локальной разработки значения мягкие.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
# Загрузка файлов: каталог (по умолчанию backend/uploads) и потолок размера
# multipart-запроса в байтах (по умолчанию 10 МБ).
UPLOAD_DIR=
MAX_UPLOAD_SIZE_BYTES=10485760

# --- Раздача собранного фронтенда тем же процессом (optional) --------------
# SERVE_STATIC=true включает статику Next.js-сборки и SPA-fallback, то есть
# один контейнер закрывает и API, и сайт. FRONTEND_DIST — путь к `next build`
# (.next/standalone не используется, нужен обычный выход Next).
SERVE_STATIC=false
FRONTEND_DIST=
# Флаг Secure у auth-cookie: true только по HTTPS (в прод-контейнере включается
# автоматически, если явно не задано).
COOKIE_SECURE=

# --- Почтовые уведомления (optional) ---------------------------------------
# Без SMTP_URL уведомления молча пропускаются — приложение работает как раньше.
# Формат: smtp://user:password@host:587
SMTP_URL=
MAIL_FROM="Гастрономия Коми <no-reply@example.org>"
