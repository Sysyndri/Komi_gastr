# Тестовое окружение.
# Пароль и адрес БД здесь НЕ хранятся: DSN тестовой базы собирается в
# src/tests/testDatabase.ts из TEST_DATABASE_URL либо из DATABASE_URL
# текущего окружения (backend/.env локально, переменные окружения в CI).
NODE_ENV=test
PORT=4100
# Имя тестовой базы: создаётся автоматически в globalSetup
TEST_DATABASE_NAME=gastro_komi_test
JWT_SECRET=test_secret_that_is_at_least_32_chars_long_1234
JWT_REFRESH_SECRET=test_refresh_secret_1234
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000