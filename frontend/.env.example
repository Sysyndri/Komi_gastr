# ============================================================================
# Шаблон окружения фронтенда. Скопируйте в frontend/.env (файл в .gitignore).
#
# NEXT_PUBLIC_* вшиваются в бандл на этапе сборки (next build / docker build):
# после их изменения образ нужно пересобрать.
# ============================================================================

# --- Адрес API --------------------------------------------------------------
# Оставьте относительный /api: браузер ходит на тот же origin, а middleware.ts
# проксирует запрос на backend (см. API_INTERNAL_URL). Тогда не нужен CORS и
# один и тот же образ годится и для localhost, и для сервера.
# Абсолютный адрес (http://host:4000/api) придётся менять при каждом переезде.
NEXT_PUBLIC_API_URL=/api

# Внутренний адрес backend для прокси middleware: локально — localhost,
# в docker compose задаётся в environment сервиса frontend (http://backend:4000/api).
API_INTERNAL_URL=http://localhost:4000/api

# --- Публичный адрес и подписи ---------------------------------------------
# В docker compose берутся из корневого .env (SITE_URL / SITE_NAME / SITE_TAGLINE).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Гастрономия Коми
NEXT_PUBLIC_SITE_TAGLINE=Национальная кухня Республики Коми

# --- Яндекс.Карты ----------------------------------------------------------
# JS API 3.0 требует ключ с заполненным «Ограничение по HTTP Referer»
# (https://developer.tech.yandex.com/, «JavaScript API и HTTP Геокодер»).
# Без ключа карта заменяется списком заведений.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=