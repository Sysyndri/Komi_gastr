# ============================================================================
# Шаблон окружения платформы «Гастрономия Коми».
# Скопируйте в .env (файл в .gitignore) и заполните значения.
#
#   cp .env.example .env
#   bash deploy.sh
#
# СЕКРЕТЫ НЕ КОММИТЯТСЯ: этот файл — только шаблон, пустые значения обязательны
# для запуска и проверяются docker-compose (`${VAR:?}`) и backend (zod).
# Генерация стойкого секрета:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# ===== Режим работы =====
# production — backend и frontend собираются и запускаются в продакшен-режиме
NODE_ENV=production
TZ=Europe/Moscow

# ===== Публичные адреса (главное при переносе на сервер) =====
# SITE_URL — адрес, по которому пользователи открывают сайт.
# CORS_ORIGIN — тот же адрес: backend разрешает запросы только с него.
# NEXT_PUBLIC_API_URL — адрес API для браузера; подшивается в бандл фронтенда
#   при сборке образа (при смене нужна пересборка: docker compose build --no-cache frontend).
# Пример для сервера 85.192.20.218:
SITE_URL=http://85.192.20.218:3000
CORS_ORIGIN=http://85.192.20.218:3000
NEXT_PUBLIC_API_URL=http://85.192.20.218:4000/api
# Публичный адрес этого API (логи, HSTS, Swagger)
API_PUBLIC_URL=http://85.192.20.218:4000/api

# Для локальной разработки замените адрес на localhost:
#   SITE_URL=http://localhost:3000
#   CORS_ORIGIN=http://localhost:3000
#   NEXT_PUBLIC_API_URL=http://localhost:4000/api
#   API_PUBLIC_URL=http://localhost:4000/api

# ===== PostgreSQL =====
POSTGRES_USER=komi
POSTGRES_PASSWORD=
POSTGRES_DB=gastro_komi
# Порт публикуется только на 127.0.0.1 хоста (см. docker-compose.yml)
POSTGRES_PORT=5432
# DSN для backend. В docker-compose этот же DSN собирается сам с адресом
# хоста `postgres` (внутренняя сеть контейнеров) — значение ниже нужно для
# локального запуска backend без Docker.
DATABASE_URL=postgresql://komi:@localhost:5432/gastro_komi?schema=public

# ===== Backend =====
PORT=4000
# Секреты подписи токенов: длина >= 32 символов, значения должны различаться
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# API за reverse-proxy (nginx): 1 — брать клиентский IP из X-Forwarded-For
# (важно для rate-limit). Если порты 3000/4000 открыты напрямую — оставьте 0.
TRUST_PROXY=0
# Swagger UI (/api-docs) в production по умолчанию выключен
SWAGGER_ENABLED=false

# ===== Публикация портов на хосте =====
BACKEND_PORT=4000
FRONTEND_PORT=3000
# Документация MkDocs доступна только с самого сервера
DOCS_PORT=8000

# ===== Frontend =====
# Название и подпись в шапке/метатегах
SITE_NAME=Гастрономия Коми
SITE_TAGLINE=Национальная кухня Республики Коми
# Ключ JS API Яндекс.Карт 3.0 (developer.tech.yandex.ru, «JavaScript API и HTTP
# Геокодер»). В ограничении по HTTP Referer нужно указать адрес продакшена —
# 85.192.20.218 — иначе карта ответит 403. Без ключа вместо карты показывается
# список заведений.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ===== Учётные данные для seed (npm run seed в контейнере backend) =====
# Нужны только при наполнении базы демо-контентом; для запуска приложения — нет.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Тестовые пользователи (интеграционным/E2E-тестам)
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
SEED_TEST_EMAIL=
SEED_TEST_PASSWORD=
