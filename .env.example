# ============================================================================
# Шаблон окружения платформы «Гастрономия Коми».
#
#   cp .env.example .env     # и заполните секреты
#   bash deploy.sh           # сборка и запуск всего стека
#
# Секреты в репозиторий не попадают: .env добавлен в .gitignore.
# Генерация стойкого секрета:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Локально и на сервере отличается ТОЛЬКО блок «Публичные адреса» —
# compose-файл и образы одни и те же.
# ============================================================================

# ===== Режим работы =====
# production — backend и frontend собираются и запускаются в продакшен-режиме
NODE_ENV=production
TZ=Europe/Moscow

# ===== Публичные адреса =====
# ЛОКАЛЬНО (docker compose на своей машине):
#   ALLOW_LOCALHOST=true
#   SITE_URL=http://localhost:3000
#   CORS_ORIGIN=http://localhost:3000
#   API_PUBLIC_URL=http://localhost:4000/api
#
# НА СЕРВЕРЕ (пример для 85.192.20.218):
#   ALLOW_LOCALHOST=false
#   SITE_URL=http://85.192.20.218:3000
#   CORS_ORIGIN=http://85.192.20.218:3000
#   API_PUBLIC_URL=http://85.192.20.218:4000/api
#
# ALLOW_LOCALHOST=true разрешает localhost в публичных адресах при
# NODE_ENV=production: это нужно только локальному стенду, где нет домена.
# На сервере оставьте false — тогда забытые адреса ловятся при старте.
ALLOW_LOCALHOST=false
SITE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api

# NEXT_PUBLIC_API_URL специально НЕ задаётся: frontend собирается с
# относительным /api и ходит через middleware того же origin, поэтому образ
# не зависит от адреса сервера. Адрес backend внутри сети контейнеров задан
# в docker-compose.yml (API_INTERNAL_URL = http://backend:4000/api).

# ===== PostgreSQL =====
POSTGRES_USER=komi
POSTGRES_PASSWORD=
POSTGRES_DB=gastro_komi
# Порт публикуется только на 127.0.0.1 хоста (см. docker-compose.yml)
POSTGRES_PORT=5432
# DSN нужен только для локального запуска backend без Docker
# (в compose строка собирается автоматически с хостом `postgres`).
DATABASE_URL=postgresql://komi:ПАРОЛЬ_ИЗ_POSTGRES_PASSWORD@localhost:5432/gastro_komi?schema=public

# ===== Backend =====
PORT=4000
# Секреты подписи токенов: значения должны различаться и быть >= 32 символов
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# API за reverse-proxy (nginx): 1 — брать клиентский IP из X-Forwarded-For
# (важно для rate-limit). Если порты 3000/4000 открыты напрямую — оставьте 0.
TRUST_PROXY=0
# Swagger UI (/api-docs) в production по умолчанию выключен
SWAGGER_ENABLED=false

# ===== Лимиты запросов (окно в мс / число запросов на IP) =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# ===== Публикация портов на хосте =====
BACKEND_PORT=4000
FRONTEND_PORT=3000
# Документация MkDocs доступна только с самого сервера
DOCS_PORT=8000

# ===== Frontend =====
SITE_NAME=Гастрономия Коми
SITE_TAGLINE=Национальная кухня Республики Коми
# Ключ JS API Яндекс.Карт 3.0 (developer.tech.yandex.ru, «JavaScript API и HTTP
# Геокодер»). Для JS API 3.0 обязательно заполнить «Ограничение по HTTP Referer»
# (localhost/127.0.0.1 для разработки, домен сайта для продакшена), иначе 403.
# Без ключа вместо карты показывается список заведений.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ===== Учётные данные для seed (`npm run seed` в контейнере backend) =====
# Нужны только при наполнении базы; повторный запуск синхронизирует пароли
# с этими значениями. Старые демо-пароли из истории git отозваны.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=

