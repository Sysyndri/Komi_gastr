# ===== Общие настройки =====
NODE_ENV=development
TZ=Europe/Moscow

# ВАЖНО: этот файл — только шаблон. Не подставляйте сюда реальные пароли
# и ключи: скопируйте в .env (он в .gitignore) и сгенерируйте значения сами,
# например:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ===== PostgreSQL =====
POSTGRES_USER=komi
POSTGRES_PASSWORD=
POSTGRES_DB=gastro_komi
POSTGRES_PORT=5432
# DSN для приложения (backend) — пароль подставляется из POSTGRES_PASSWORD
DATABASE_URL=postgresql://komi@localhost:5432/gastro_komi?schema=public

# ===== Backend =====
PORT=4000
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Хост frontend для CORS
CORS_ORIGIN=http://localhost:3000
# Базовый URL API для фронтенда
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ===== Учётные данные для seed (обязательны при выполнении seed) =====
# Пароль администратора можно задать через ADMIN_PASSWORD или
# ADMIN_PASSWORD_HASH (bcrypt) — второй вариант безопаснее.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Тестовые пользователи (нужны интеграционным/E2E-тестам)
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
SEED_TEST_EMAIL=
SEED_TEST_PASSWORD=

# ===== Frontend =====
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
