# ===== Общие настройки =====
NODE_ENV=development
TZ=Europe/Moscow

# ===== PostgreSQL =====
POSTGRES_USER=komi
POSTGRES_PASSWORD=komi_password
POSTGRES_DB=gastro_komi
POSTGRES_PORT=5432
# DSN для приложения (backend)
DATABASE_URL=postgresql://komi:komi_password@localhost:5432/gastro_komi?schema=public

# ===== Backend =====
PORT=4000
JWT_SECRET=change_me_super_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Хост frontend для CORS
CORS_ORIGIN=http://localhost:3000
# Базовый URL API для фронтенда
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ===== Админ по умолчанию (seed) =====
SEED_ADMIN_EMAIL=admin@gastronomiakomi.ru
SEED_ADMIN_PASSWORD=Admin123!

# ===== Frontend =====
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=30c216da-3251-420a-a19f-4a4af763bfa2


# --- production-ready additions ---
# Public API address. For local compose keep localhost;
# on server 85.192.20.218 use http://85.192.20.218:4000/api
API_PUBLIC_URL=http://localhost:4000/api
BACKEND_PORT=4000
FRONTEND_PORT=3000
DOCS_PORT=8000

# Public frontend origin (CORS + CSP). On server use http://85.192.20.218:3000
SITE_URL=http://localhost:3000
